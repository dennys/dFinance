<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dFinance.Parsing\dFinance.Parsing.csproj" />
    <!-- 分類邏輯獨立一支：編譯期就擋住它偷偷去碰 DB／語系／網路（CLASSIFICATION.md §2）。
         代價是反過來 Data 必須只把「純事實」dump 過去，不准在那邊再寫一份比對。 -->
    <ProjectReference Include="..\dFinance.Classification\dFinance.Classification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 遷移腳本當嵌入資源：測試與 UI 都從同一个 dll 讀，不用管輸出目錄 -->
    <EmbeddedResource Include="migrations\*.sql" />
  </ItemGroup>

</Project>
