<Window x:Class="dFinance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dFinance" Height="720" Width="1180" WindowStartupLocation="CenterScreen">
<DockPanel>
<Menu DockPanel.Dock="Top">
  <MenuItem Header="檔案(_F)">
    <MenuItem Header="新資料庫…" Click="NewDb_Click"/>
    <MenuItem Header="開啟資料庫…" Click="OpenDb_Click"/>
    <MenuItem Header="另存資料庫…" Click="SaveDbAs_Click"/>
    <Separator/>
    <MenuItem x:Name="RecentMenu" Header="最近開啟"/>
    <MenuItem Header="清除最近開啟" Click="ClearRecent_Click"/>
    <Separator/>
    <MenuItem Header="結束" Click="Exit_Click"/>
  </MenuItem>
  <MenuItem Header="報表(_R)">
    <MenuItem Header="分類帳" Click="CategoryReport_Click"/>
  </MenuItem>
  <MenuItem Header="說明(_H)">
    <MenuItem Header="關於 dFinance" Click="About_Click"/>
  </MenuItem>
</Menu>
<StatusBar DockPanel.Dock="Bottom"/>
<TabControl x:Name="Tabs" Margin="8" SelectionChanged="Tabs_SelectionChanged">
  <TabItem x:Name="HomeTab" Header="首頁"/>
  <TabItem x:Name="ImportTab" Header="匯入 PDF">
  <DockPanel Margin="0">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="PDF" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="PathBox" Width="560" VerticalAlignment="Center"/>
      <Button x:Name="PickButton" Content="選檔…" Width="70" Margin="6,0,0,0" Click="Pick_Click"/>
      <TextBlock Text="密碼" VerticalAlignment="Center" Margin="12,0,6,0"/>
      <PasswordBox x:Name="PasswordBox" Width="150" VerticalAlignment="Center"
                   ToolTip="要親手打（UI 不讀 .env）。多組密碼用逗號分隔，會一組一組試。"/>
      <Button x:Name="ParseButton" Content="解析" Width="80" Margin="10,0,0,0" FontWeight="Bold" Click="Parse_Click"/>
      <Button x:Name="ImportButton" Content="匯入資料庫" Width="90" Margin="10,0,0,0" Click="Import_Click"
              ToolTip="把這份 PDF 存底並寫進資料庫（同一份檔案重匯會自動擋掉）"/>
      <Button x:Name="ImportFolderButton" Content="批次匯入資料夾…" Width="120" Margin="6,0,0,0" Click="ImportFolder_Click"/>
    </StackPanel>

    <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,4"/>
    <TextBlock x:Name="WarningText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#B00020" Margin="0,0,0,6"/>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="DbPathText" FontSize="11" Foreground="#555" Margin="0,6,0,2"/>
      <TextBox x:Name="ImportLog" Height="110" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
               ToolTip="匯入結果：每一份檔案的新增/更新/跳過與警告"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="Grid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                SelectionUnit="FullRow" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="消費日" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="88"/>
          <DataGridTextColumn Header="入帳日" Binding="{Binding PostingDate, StringFormat=yyyy/MM/dd}" Width="88"/>
          <DataGridTextColumn Header="商家" Binding="{Binding Merchant}" Width="*"/>
          <DataGridTextColumn Header="金額" Binding="{Binding Amount, StringFormat=N0}" Width="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="幣別" Binding="{Binding Currency}" Width="50"/>
          <DataGridTextColumn Header="卡" Binding="{Binding Card}" Width="55"/>
          <DataGridTextColumn Header="類別" Binding="{Binding Kind}" Width="60"/>
          <DataGridTextColumn Header="頁" Binding="{Binding Page}" Width="40"/>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#DDD"/>

      <TextBox x:Name="RawText" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="Wrap" AcceptsReturn="True"
               ToolTip="PdfPig 抽出的原始文字層，用來核對解析結果"/>
    </Grid>
  </DockPanel>
  </TabItem>
</TabControl>
</DockPanel>
</Window>
