<Window x:Class="dFinance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dFinance" Height="720" Width="1180" WindowStartupLocation="CenterScreen">
<DockPanel>
<Menu DockPanel.Dock="Top">
  <MenuItem Header="{Binding [Menu_File], Source={StaticResource Loc}}">
    <MenuItem Header="{Binding [Menu_NewDb], Source={StaticResource Loc}}" Click="NewDb_Click"/>
    <MenuItem Header="{Binding [Menu_OpenDb], Source={StaticResource Loc}}" Click="OpenDb_Click"/>
    <MenuItem Header="{Binding [Menu_SaveDbAs], Source={StaticResource Loc}}" Click="SaveDbAs_Click"/>
    <Separator/>
    <MenuItem x:Name="RecentMenu" Header="{Binding [Menu_Recent], Source={StaticResource Loc}}"/>
    <MenuItem Header="{Binding [Menu_ClearRecent], Source={StaticResource Loc}}" Click="ClearRecent_Click"/>
    <Separator/>
    <MenuItem Header="{Binding [Menu_Exit], Source={StaticResource Loc}}" Click="Exit_Click"/>
  </MenuItem>
  <MenuItem Header="{Binding [Menu_Reports], Source={StaticResource Loc}}">
    <MenuItem Header="{Binding [Menu_CategoryReport], Source={StaticResource Loc}}" Click="CategoryReport_Click"/>
  </MenuItem>
  <MenuItem Header="{Binding [Menu_Tools], Source={StaticResource Loc}}">
    <MenuItem Header="{Binding [Menu_CategoryManager], Source={StaticResource Loc}}" Click="CategoryManager_Click"/>
    <MenuItem Header="{Binding [Menu_Currency], Source={StaticResource Loc}}" Click="CurrencyManager_Click"/>
    <MenuItem x:Name="LanguageMenu" Header="{Binding [Menu_Language], Source={StaticResource Loc}}"/>
  </MenuItem>
  <MenuItem Header="{Binding [Menu_Help], Source={StaticResource Loc}}">
    <MenuItem Header="{Binding [Menu_About], Source={StaticResource Loc}}" Click="About_Click"/>
  </MenuItem>
</Menu>
<StatusBar DockPanel.Dock="Bottom"/>
<TabControl x:Name="Tabs" Margin="8" SelectionChanged="Tabs_SelectionChanged">
  <TabItem x:Name="HomeTab" Header="{Binding [Tab_Home], Source={StaticResource Loc}}"/>
  <TabItem x:Name="ImportTab" Header="{Binding [Tab_Import], Source={StaticResource Loc}}">
  <DockPanel Margin="0">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="PDF" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="PathBox" Width="560" VerticalAlignment="Center"/>
      <Button x:Name="PickButton" Content="{Binding [Import_Pick], Source={StaticResource Loc}}" Width="70" Margin="6,0,0,0" Click="Pick_Click"/>
      <TextBlock Text="{Binding [Import_Password], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="12,0,6,0"/>
      <PasswordBox x:Name="PasswordBox" Width="150" VerticalAlignment="Center"
                   ToolTip="{Binding [Import_PasswordHint], Source={StaticResource Loc}}"/>
      <Button x:Name="ParseButton" Content="{Binding [Import_Parse], Source={StaticResource Loc}}" Width="80" Margin="10,0,0,0" FontWeight="Bold" Click="Parse_Click"/>
      <Button x:Name="ImportButton" Content="{Binding [Import_ToDb], Source={StaticResource Loc}}" Width="90" Margin="10,0,0,0" Click="Import_Click"
              ToolTip="{Binding [Import_ToDbHint], Source={StaticResource Loc}}"/>
      <Button x:Name="ImportFolderButton" Content="{Binding [Import_Folder], Source={StaticResource Loc}}" Width="120" Margin="6,0,0,0" Click="ImportFolder_Click"/>
    </StackPanel>

    <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,4"/>
    <TextBlock x:Name="WarningText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#B00020" Margin="0,0,0,6"/>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="DbPathText" FontSize="11" Foreground="#555" Margin="0,6,0,2"/>
      <TextBox x:Name="ImportLog" Height="110" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
               ToolTip="{Binding [Import_LogHint], Source={StaticResource Loc}}"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="Grid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                SelectionUnit="FullRow" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{Binding [Import_Col_SpendDate], Source={StaticResource Loc}}" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="88"/>
          <DataGridTextColumn Header="{Binding [Import_Col_PostingDate], Source={StaticResource Loc}}" Binding="{Binding PostingDate, StringFormat=yyyy/MM/dd}" Width="88"/>
          <DataGridTextColumn Header="{Binding [Common_Merchant], Source={StaticResource Loc}}" Binding="{Binding Merchant}" Width="*"/>
          <DataGridTextColumn Header="{Binding [Common_Amount], Source={StaticResource Loc}}" Binding="{Binding Amount, StringFormat=N2}" Width="88">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="{Binding [Common_Currency], Source={StaticResource Loc}}" Binding="{Binding Currency}" Width="50"/>
          <DataGridTextColumn Header="{Binding [Import_Col_Card], Source={StaticResource Loc}}" Binding="{Binding Card}" Width="55"/>
          <DataGridTextColumn Header="{Binding [Import_Col_Page], Source={StaticResource Loc}}" Binding="{Binding Page}" Width="40"/>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#DDD"/>

      <TextBox x:Name="RawText" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="Wrap" AcceptsReturn="True"
               ToolTip="{Binding [Import_RawHint], Source={StaticResource Loc}}"/>
    </Grid>
  </DockPanel>
  </TabItem>
</TabControl>
</DockPanel>
</Window>
