<UserControl x:Class="dFinance.LedgerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             FontSize="13">
  <UserControl.Resources>
    <!-- 列態要用「形狀 + 顏色」双重表達：灰底=孤兒、灰字=不記、紅粗體=沒有消費日、藍=負額 -->
    <Style x:Key="LedgerRow" TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Orphaned}" Value="True"><Setter Property="Background" Value="#EFEFEF"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="ignored"><Setter Property="Foreground" Value="#8A8A8A"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="duplicate"><Setter Property="Foreground" Value="#8A8A8A"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="AmountCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="#0B5FA5"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DateCell" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding NeedsDate}" Value="True">
          <Setter Property="Foreground" Value="#B00020"/><Setter Property="FontWeight" Value="Bold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>

    <!-- 篩選列 -->
    <DockPanel x:Name="FilterBar" DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,4">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Content="{Binding [Ledger_AddEntry], Source={StaticResource Loc}}" Width="80" Margin="6,0,0,0"
              FontWeight="Bold" Click="Add_Click" ToolTip="{Binding [Ledger_AddEntryHint], Source={StaticResource Loc}}"/>
      <Button x:Name="OpenAccountButton" DockPanel.Dock="Right" Content="{Binding [Ledger_OpenAccount], Source={StaticResource Loc}}" Width="90" Margin="6,0,0,0"
              Click="OpenAccount_Click" ToolTip="{Binding [Ledger_OpenAccountHint], Source={StaticResource Loc}}"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding [Common_Date], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox x:Name="PresetBox" Width="72" VerticalAlignment="Center" SelectionChanged="Preset_Changed"/>
        <DatePicker x:Name="FromBox" Width="112" Margin="6,0,0,0" VerticalAlignment="Center" SelectedDateChanged="Range_Changed"/>
        <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center"/>
        <DatePicker x:Name="ToBox" Width="112" VerticalAlignment="Center" SelectedDateChanged="Range_Changed"/>

        <TextBlock x:Name="AccountLabel" Text="{Binding [Common_Account], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <ComboBox x:Name="AccountBox" Width="190" VerticalAlignment="Center" SelectionChanged="Filter_Changed"
                  DisplayMemberPath="Label" SelectedValuePath="Id"/>
        <TextBlock Text="{Binding [Common_Category], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <ComboBox x:Name="CategoryBox" Width="150" VerticalAlignment="Center" SelectionChanged="Filter_Changed"
                  DisplayMemberPath="Label" SelectedValuePath="Id"/>
        <TextBlock Text="{Binding [Common_Status], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <ComboBox x:Name="StatusBox" Width="104" VerticalAlignment="Center" SelectionChanged="Filter_Changed"
                  DisplayMemberPath="Label" SelectedValuePath="Mode"/>
        <TextBox x:Name="SearchBox" Width="150" Margin="12,0,0,0" VerticalAlignment="Center" KeyUp="Search_KeyUp"
                 ToolTip="{Binding [Ledger_SearchHint], Source={StaticResource Loc}}"/>
        <Button Content="{Binding [Ledger_Reset], Source={StaticResource Loc}}" Width="52" Margin="6,0,0,0" Click="Reset_Click"/>
      </StackPanel>
    </DockPanel>

    <!-- 動作列（作用在選取的列） -->
    <DockPanel x:Name="ActionBar" DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,4">
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#555"/>
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#888" Margin="0,0,10,0"
                 Text="{Binding [Ledger_AmountReadonly], Source={StaticResource Loc}}"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="{Binding [Ledger_Settle], Source={StaticResource Loc}}" Width="52" Click="Status_Click" Tag="cleared"/>
        <Button Content="{Binding [Ledger_Ignore], Source={StaticResource Loc}}" Width="52" Margin="4,0,0,0" Click="Status_Click" Tag="ignored"/>
        <Button Content="{Binding [Ledger_Duplicate], Source={StaticResource Loc}}" Width="52" Margin="4,0,0,0" Click="Status_Click" Tag="duplicate"
                ToolTip="{Binding [Ledger_DuplicateHint], Source={StaticResource Loc}}"/>
        <Button Content="{Binding [Ledger_Delete], Source={StaticResource Loc}}" Width="52" Margin="4,0,0,0" Click="Delete_Click"
                ToolTip="{Binding [Ledger_DeleteHint], Source={StaticResource Loc}}"/>
        <Button Content="{Binding [Common_Restore], Source={StaticResource Loc}}" Width="52" Margin="4,0,0,0" Click="Restore_Click"/>
        <Button Content="{Binding [Ledger_AddCategory], Source={StaticResource Loc}}" Width="60" Margin="10,0,0,0" Click="AddCategory_Click"/>
        <Button Content="{Binding [Ledger_Accounts], Source={StaticResource Loc}}" Width="60" Margin="10,0,0,0" Click="Accounts_Click"
                ToolTip="{Binding [Ledger_AccountsHint], Source={StaticResource Loc}}"/>
        <Button Content="{Binding [Ledger_Suggest], Source={StaticResource Loc}}" Width="80" Margin="10,0,0,0" Click="Suggest_Click"
                ToolTip="{Binding [Ledger_SuggestHint], Source={StaticResource Loc}}"/>
      </StackPanel>
    </DockPanel>

    <!-- 概況：一律当场用 SQL 算，不建 rollup 表 -->
    <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,4">
      <StackPanel>
        <TextBlock x:Name="AccountHeaderText" FontWeight="Bold" Visibility="Collapsed"/>
        <TextBlock x:Name="KpiText" FontSize="14" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- 分類帳報表：分類（樹）× 月 透視表。這裡不能包 ScrollViewer：外層給了無限高度，
         DataGrid 的列/欄虛擬化就會整個失效（幾百列 × 幾十欄會卡）。 -->
    <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="4,0">
          <ComboBox x:Name="ReportRangeBox" Width="110" DockPanel.Dock="Left" SelectionChanged="ReportRange_SelectionChanged"/>
          <ComboBox x:Name="ReportModeBox" Width="92" DockPanel.Dock="Left" Margin="8,0,0,0"
                    SelectionChanged="ReportMode_SelectionChanged"
                    ToolTip="{Binding [Report_ModeTip], Source={StaticResource Loc}}"/>
          <TextBlock x:Name="ReportNote" Foreground="#B00000" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
        </DockPanel>
        <DataGrid x:Name="CategoryReportGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  FontSize="13"
                  Margin="4"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Sorting="Report_Sorting"
                  PreviewMouseLeftButtonUp="CategoryReport_CellClick">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSummary}" Value="True">   <!-- 支出/收入那兩塊與最後一列總計 -->
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="#F1F1F1"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>
      </Grid>
    </Border>

    <!-- 警示列：點了就把它變成篩選 -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4" Margin="0,4,0,0">
      <WrapPanel>
        <Button x:Name="OrphanButton" Margin="0,0,8,0" Click="Orphan_Click"
                ToolTip="{Binding [Ledger_OrphanHint], Source={StaticResource Loc}}"/>
        <Button x:Name="DuplicateButton" Margin="0,0,8,0" Click="Duplicate_Click"
                ToolTip="{Binding [Ledger_DupGroupHint], Source={StaticResource Loc}}"/>
        <Button x:Name="BalanceButton" Margin="0,0,8,0" Click="Balance_Click"
                ToolTip="{Binding [Ledger_MismatchHint], Source={StaticResource Loc}}"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" FontSize="11"/>
      </WrapPanel>
    </Border>

    <Grid x:Name="LedgerPanel">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="LedgerGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionUnit="FullRow"
                RowStyle="{StaticResource LedgerRow}" SelectionChanged="Grid_SelectionChanged"
                CellEditEnding="Grid_CellEditEnding" MouseDoubleClick="Grid_MouseDoubleClick" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Dot}" Width="22" IsReadOnly="True"
                              ElementStyle="{StaticResource DateCell}"/>
          <!-- entry id：人講「第 4317 筆」要有得指。只讀、不准編輯（改了也沒意義，那是主鍵）。 -->
          <DataGridTextColumn Header="{Binding [Ledger_Col_Id], Source={StaticResource Loc}}" Binding="{Binding Id}" Width="56"
                              IsReadOnly="True" ElementStyle="{StaticResource DateCell}"/>
          <DataGridTextColumn x:Name="DateCol" Header="{Binding [Import_Col_SpendDate], Source={StaticResource Loc}}" Binding="{Binding Date}" Width="92"
                              ElementStyle="{StaticResource DateCell}" EditingElementStyle="{StaticResource DateCell}"/>
          <DataGridTextColumn x:Name="MerchantCol" Header="{Binding [Common_Merchant], Source={StaticResource Loc}}" Binding="{Binding Merchant}" Width="2*"/>
          <DataGridTemplateColumn x:Name="CategoryCol" Header="{Binding [Common_Category], Source={StaticResource Loc}}" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Category}" VerticalAlignment="Center"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id" DisplayMemberPath="Name"
                          SelectedValue="{Binding CategoryId, Mode=TwoWay}" IsEnabled="{Binding CanPickCategory}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{Binding [Common_Amount], Source={StaticResource Loc}}" Binding="{Binding AmountText}" Width="90" IsReadOnly="True"
                              ElementStyle="{StaticResource AmountCell}"/>
          <DataGridTextColumn x:Name="AccountCol" Header="{Binding [Common_Account], Source={StaticResource Loc}}" Binding="{Binding Account}" Width="140" IsReadOnly="True"/>
          <DataGridTextColumn Header="{Binding [Common_Status], Source={StaticResource Loc}}" Binding="{Binding StatusText}" Width="54" IsReadOnly="True"/>
          <DataGridTextColumn x:Name="NoteCol" Header="{Binding [Common_Note], Source={StaticResource Loc}}" Binding="{Binding Note}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#DDD"/>

      <DockPanel Grid.Column="2" Margin="0">
        <TextBlock DockPanel.Dock="Top" Text="{Binding [Ledger_Col_Lineage], Source={StaticResource Loc}}" FontWeight="Bold" Margin="0,0,0,4"/>
        <Button x:Name="OpenPdfButton" DockPanel.Dock="Bottom" Content="{Binding [Ledger_OpenPdf], Source={StaticResource Loc}}" Margin="0,4,0,0"
                HorizontalAlignment="Left" Width="120" Click="OpenPdf_Click"
                ToolTip="{Binding [Ledger_OpenPdfHint], Source={StaticResource Loc}}"/>
        <TextBox x:Name="LineageBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 ToolTip="{Binding [Ledger_LineageHint], Source={StaticResource Loc}}"/>
      </DockPanel>
    </Grid>

    <!-- 首頁：左邊淨值明細（點一列就開該帳戶分頁），右上每月總資產，右下未來帳單 -->
    <Grid x:Name="HomePanel" Visibility="Collapsed" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{Binding [Home_NetWorth], Source={StaticResource Loc}}" FontWeight="Bold" Margin="0,0,0,4"/>
        <DataGrid x:Name="HomeNetWorthGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12"
                  MouseLeftButtonUp="HomeNetWorth_Click" ToolTip="{Binding [Home_NetWorthHint], Source={StaticResource Loc}}">
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Background="#F2F2F2" Padding="4,2"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="{Binding [Common_Account], Source={StaticResource Loc}}" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="{Binding [Common_Type], Source={StaticResource Loc}}" Binding="{Binding TypeLabel}" Width="60"/>
            <DataGridTextColumn Header="{Binding [Common_Currency], Source={StaticResource Loc}}" Binding="{Binding Currency}" Width="46"/>
            <DataGridTextColumn Header="{Binding [Common_Balance], Source={StaticResource Loc}}" Binding="{Binding BalanceText}" Width="100"/>
            <DataGridTextColumn x:Name="ConvertedCol" Header="{Binding [Home_Converted], Source={StaticResource Loc}}" Binding="{Binding ConvertedText}" Width="110"/>
            <DataGridTextColumn Header="{Binding [Home_CountedIn], Source={StaticResource Loc}}" Binding="{Binding CountedText}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#DDD"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding [Home_MonthlyAssets], Source={StaticResource Loc}}" FontWeight="Bold" Margin="0,0,0,4"/>
          <sp:WpfPlot x:Name="NetWorthPlot"/>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#DDD"/>

        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Text="{Binding [Home_Upcoming], Source={StaticResource Loc}}" FontWeight="Bold" Margin="0,0,0,4"/>
          <DataGrid x:Name="UpcomingGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{Binding [Common_Date], Source={StaticResource Loc}}" Binding="{Binding Date}" Width="86"/>
              <DataGridTextColumn Header="{Binding [Home_Item], Source={StaticResource Loc}}" Binding="{Binding Label}" Width="*"/>
              <DataGridTextColumn Header="{Binding [Common_Amount], Source={StaticResource Loc}}" Binding="{Binding AmountText}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <!-- 只有信用卡帳單那幾列有 BillId，其餘由 LoadingRow 藏起來 -->
              <DataGridTemplateColumn Header="{Binding [Home_MarkPaid], Source={StaticResource Loc}}" Width="64">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{Binding [Home_MarkPaid], Source={StaticResource Loc}}" Padding="4,0"
                            Click="MarkPaid_Click" Tag="{Binding}"
                            Visibility="{Binding IsBill, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding [Home_MarkPaidHint], Source={StaticResource Loc}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
