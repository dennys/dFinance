<UserControl x:Class="dFinance.BillPeriodTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">
  <UserControl.Resources>
    <!-- 對不上（消費合計 ≠ 單上應繳）是這張表要抓的東西，用顏色推一把；但顏色不是唯一線索，⚠ 那欄也有字。 -->
    <Style x:Key="NumberCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style x:Key="DiffCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Mismatch}" Value="True"><Setter Property="Foreground" Value="#B00000"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,4">
      <DockPanel Margin="4,0">
        <ComboBox x:Name="RangeBox" Width="110" DockPanel.Dock="Left" SelectionChanged="Range_SelectionChanged"/>
        <CheckBox x:Name="OnlyMismatchBox" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                  Content="{Binding [Bill_OnlyMismatch], Source={StaticResource Loc}}"
                  Checked="OnlyMismatch_Changed" Unchecked="OnlyMismatch_Changed"/>
        <TextBlock x:Name="TotalsText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <TextBlock x:Name="TipText" DockPanel.Dock="Bottom" Foreground="#666" Margin="6,4"
               TextWrapping="Wrap" Text="{Binding [Bill_ClickTip], Source={StaticResource Loc}}"/>

    <DataGrid x:Name="BillGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="13" Margin="4"
              EnableRowVirtualization="True" SelectionUnit="FullRow"
              PreviewMouseLeftButtonUp="Grid_Click"/>
  </DockPanel>
</UserControl>
